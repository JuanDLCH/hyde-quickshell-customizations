#!/bin/sh
# Screenshot client: shot full | shot region | shot crop X Y W H   (crop = internal, called by the picker)
dir=${XDG_RUNTIME_DIR:-/tmp}/shot; mkdir -p "$dir"
pics=$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures"); out=$pics/Screenshots; mkdir -p "$out"
file=$out/$(date +'%y%m%d_%Hh%Mm%Ss_screenshot.png')

finish() {
    wl-copy --type image/png < "$file"
    notify-send -a Screenshot -i "$file" "Screenshot saved" "$(basename "$file")"
}

case "$1" in
full)
    grim "$file" && finish ;;
region)
    mon=$(hyprctl monitors -j | jq '.[] | select(.focused)')
    name=$(echo "$mon" | jq -r .name)
    grim -o "$name" "$dir/freeze.png" || exit 1
    echo "$mon" | jq --slurpfile c <(hyprctl clients -j) '
      . as $m | {mon: {name: $m.name, x: $m.x, y: $m.y, w: ($m.width / $m.scale), h: ($m.height / $m.scale), pw: $m.width},
        frozen: "'"$dir"'/freeze.png",
        wins: [ $c[0][] | select(.mapped and (.hidden | not) and .monitor == $m.id and .workspace.id == $m.activeWorkspace.id)
                | {x: (.at[0] - $m.x), y: (.at[1] - $m.y), w: .size[0], h: .size[1], z: .focusHistoryID, title: .class} ] | sort_by(.z) }' > "$dir/info.json"
    exec quickshell ipc -c screenshot call shot region ;;
crop)
    pw=$(jq .mon.pw "$dir/info.json"); lw=$(jq .mon.w "$dir/info.json")
    set -- $(awk -v s="$(echo "$pw $lw" | awk '{print $1/$2}')" -v x="$2" -v y="$3" -v w="$4" -v h="$5" 'BEGIN{printf "%d %d %d %d", x*s, y*s, w*s, h*s}')
    magick "$dir/freeze.png" -crop "${3}x${4}+${1}+${2}" +repage "$file" && finish ;;
esac
